# =====================================================================
# LegalEase Environment Configuration
# =====================================================================

# Google Gemini API Key (Required)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemma-4-26b-a4b-it, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# CORS Allowed Origins (Comma-separated, defaults to * for all)
ALLOWED_ORIGINS=*

# Streamlit API Backend URL (Used when running frontend/app.py)
LEGALEASE_API_URL=http://localhost:8000
